{
  "name": "luxetrade",
  "version": "1.3.0",
  "description": "Desktop market watch with audio price alerts",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never && node scripts/fix-update-filenames.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.luxetrade.desktop",
    "productName": "LuxeTrade",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "tara-nd",
      "repo": "luxetrade"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
